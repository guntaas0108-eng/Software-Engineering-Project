# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — DB_ENGINE=postgresql (proposal default) or sqlite (quick local testing)
DB_ENGINE=postgresql
DB_NAME=realestate_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Hugging Face model (Person 1) ---
# Fill these in AFTER training the model and running push_to_hf.py.
# HF_MODEL_REPO_ID is the repo you pushed model.joblib to, e.g.:
HF_MODEL_REPO_ID=your-username/realestate-price-predictor
HF_MODEL_FILENAME=model.joblib
HF_TOKEN=

# Sprint 4 chat: blank uses local in-memory layer; set Redis for staging/production
REDIS_URL=

# --- Sprint 5: Razorpay (use TEST keys during development) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
APPOINTMENT_FEE_PAISE=50000
